  "narrative": {
    "northStar": "Compact Liquid Glass",
    "overview": "Black glass, a static silver ambient wash and glossy upper bevels make the real day schedule a compact stack. The approved reference supplies material and narrow composition; actual portal data supplies dates, people, rooms and uncertainty. Light mode keeps the same geometry with pale glass and darker ink.\n\nThe current system is the final cascade of styles/campus.css, styles/liquid.css and styles/replica.css, with local fonts and utilities in styles/input.css. static/replica.js adapts the existing service-backed interface. Context stays close to the selected lesson, teacher or room.",
    "keyCharacteristics": [
      "One narrow agenda column on phones and desktop.",
      "Neutral glass bodies with silver bevels and categorical borders, shadows and labels.",
      "Emerald current state and room with independently meaningful lesson-type labels.",
      "Contextual bottom sheets, truthful source status and keyboard alternatives."
    ],
    "rules": [
      {
        "name": "The State With Meaning Rule",
        "body": "Current framing and room may turn emerald; the lesson-type label must retain the actual category and readable text.",
        "section": "colors"
      },
      {
        "name": "The Meaning Survives Density Rule",
        "body": "Compact presentation keeps full subjects, parallel lessons, source warnings and text labels available.",
        "section": "typography"
      },
      {
        "name": "The Material Has Edges Rule",
        "body": "Keep the upper highlight, darker lower edge and translucent body together; flat tint alone does not reproduce this world.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve truthful source status, real dates, lesson categories and room identities.",
      "**Do** retain the narrow agenda geometry on desktop and phone.",
      "**Do** use local Inter and JetBrains Mono for their established roles.",
      "**Do** retain access to full lesson/source details, focus, light mode and reduced-motion/transparency alternatives."
    ],
    "donts": [
      "**Don't** import demonstration schedules, invent floors or addresses, or infer physical occupancy.",
      "**Don't** restore a sidebar, hero above the agenda or floating navigation to the approved first screen.",
      "**Don't** repaint current lesson-type labels emerald or replace source warnings with colour alone.",
      "**Don't** flatten the bevel or add continuous ambient animation."
    ]
  }
}
