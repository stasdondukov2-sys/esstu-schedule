    {
      "name": "Lesson glass",
      "kind": "card",
      "refersTo": "lesson-card",
      "html": "<article class=\"ds-card\" tabindex=\"0\" role=\"group\" aria-label=\"Открыть заметку\"><section><div class=\"ds-summary\"><strong>Выберите расписание</strong><span>Данные появятся после загрузки источника.</span></div></section></article>",
      "css": ".ds-card{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);background:radial-gradient(300px circle at 25% 15%,rgba(255,255,255,.1),transparent 65%),linear-gradient(145deg,rgba(255,255,255,.08),rgba(18,20,28,.55) 48%,rgba(8,10,16,.8));border:1px solid rgba(var(--liquid-rgb,148,163,184),.42);box-shadow:inset 0 1.5px 2px rgba(255,255,255,.32),inset 0 -1px 3px rgba(255,255,255,.08),0 16px 34px -10px rgba(0,0,0,.78);border-radius:22px;padding:13px;backdrop-filter:blur(28px) saturate(185%)}.ds-card:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-card .ds-summary{cursor:pointer;min-height:0;list-style:none}.ds-card strong{display:block;font-size:15.5px;font-weight:750;line-height:1.35;letter-spacing:-.018em}.ds-card span,.ds-card p{display:block;font-size:.75rem;line-height:1.5;color:var(--campus-muted,#bcc5d2)}.ds-card .ds-summary:hover strong{color:var(--campus-accent,#50dbb1)}.ds-card .ds-summary:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}@media(max-width:700px){.ds-card{padding:13px}}@media(prefers-reduced-transparency:reduce){.ds-card{background:var(--campus-panel,#101218);backdrop-filter:none}}@supports not(backdrop-filter:blur(1px)){.ds-card{background:var(--campus-panel,#101218)}}",
      "description": "Compact lesson section. In the app the card/subject opens full lesson/source metadata in the note sheet; teacher and room actions are independent. Each source pair remains separate, including consecutive online lessons."
