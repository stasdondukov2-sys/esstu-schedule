      "name": "Filled action",
      "kind": "button",
      "refersTo": "button-primary",
      "html": "<button class=\"ds-primary\">Сохранить</button>",
      "css": ".ds-primary{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);transition:background-color 160ms ease,border-color 160ms ease,transform 120ms cubic-bezier(.23,1,.32,1);font-size:1rem;min-height:44px;padding:0 16px;border:0;border-radius:9px;background:var(--campus-solid,#087958);color:#fff;cursor:pointer}.ds-primary:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-primary:hover{background:var(--campus-solid,#087958)}.ds-primary:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}",
