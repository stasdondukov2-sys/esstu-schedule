    {
      "name": "Glass surface",
      "kind": "card",
      "refersTo": "glass-panel",
      "description": "Shared translucent major surface.",
      "html": "<section class=\"ds-panel\"><h3>Сегодня</h3><p>Выберите расписание</p></section>",
      "css": ".ds-panel{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;color:var(--campus-ink,#f1f2f8);border:1px solid var(--campus-line,rgba(213,219,255,.15));background:var(--campus-glass,rgba(29,33,48,.82));padding:24px;border-radius:16px;}.ds-panel h3{margin:0;font-size:22px;font-weight:600}.ds-panel p{color:var(--campus-muted,#b2b9cd);font-size:12px}@supports(backdrop-filter:blur(1px)){.ds-panel{backdrop-filter:blur(22px)}}@supports not(backdrop-filter:blur(1px)){.ds-panel{background:var(--campus-panel,#1c2030)}}@media(prefers-reduced-transparency:reduce){.ds-panel{background:var(--campus-panel,#1c2030);backdrop-filter:none}}"
    },
    {
      "name": "Floating navigation",
      "kind": "nav",
      "refersTo": "floating-nav",
      "description": "Three schedule actions. The schedule remains highlighted while dialogs open.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><button type=\"button\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 4h16v16H4z M4 9h16 M9 9v11\"/></svg><span>Расписание</span></button><button type=\"button\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M15 15l6 6 M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0\"/></svg><span>Поиск</span></button><button type=\"button\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M6 21V3h12v18 M3 21h18 M14 12h1\"/></svg><span>Аудитории</span></button></nav>",
      "css": ".ds-nav{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;background:var(--campus-glass,rgba(29,33,48,.82));border:1px solid var(--campus-line,rgba(213,219,255,.15));display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:8px;border-radius:18px;width:390px;max-width:100%;}.ds-nav button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:52px;padding:6px 8px;border-radius:12px;border:0;background:transparent;color:var(--campus-muted,#b2b9cd);cursor:pointer}.ds-nav button:first-child,.ds-nav button:hover{background:var(--campus-accent-soft,rgba(169,135,247,.17));color:var(--campus-accent,#cfbfff)}.ds-nav button:focus-visible{outline:2px solid var(--campus-focus,#d5c7ff);outline-offset:4px;}.ds-nav svg{width:19px;height:19px}.ds-nav span{font-size:11px;font-weight:500}@supports(backdrop-filter:blur(1px)){.ds-nav{backdrop-filter:blur(22px)}}@supports not(backdrop-filter:blur(1px)){.ds-nav{background:var(--campus-panel,#1c2030)}}@media(prefers-reduced-transparency:reduce){.ds-nav{background:var(--campus-panel,#1c2030);backdrop-filter:none}}"
    },
    {
      "name": "Lesson disclosure",
      "kind": "custom",
      "refersTo": "glass-panel",
      "description": "Native details row. Preview contains no invented lesson.",
      "html": "<details class=\"ds-lesson\"><summary><span>Занятие</span><strong>Выберите расписание</strong></summary><p>Данные появятся после загрузки источника.</p></details>",
      "css": ".ds-lesson{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;color:var(--campus-ink,#f1f2f8);border-top:1px solid var(--campus-line,rgba(213,219,255,.15));padding:23px 0;}.ds-lesson summary{cursor:pointer;list-style:none;min-height:78px;border-radius:6px}.ds-lesson summary::-webkit-details-marker{display:none}.ds-lesson summary>span{display:block;font-size:11px;color:var(--campus-muted,#b2b9cd);margin-bottom:8px}.ds-lesson strong{font-size:15px;font-weight:600;line-height:1.45;overflow-wrap:anywhere}.ds-lesson p{font-size:12px;color:var(--campus-muted,#b2b9cd)}.ds-lesson summary:hover strong{color:var(--campus-accent,#cfbfff)}.ds-lesson summary:focus-visible{outline:2px solid var(--campus-focus,#d5c7ff);outline-offset:4px;}"
    }
  ],
  "narrative": {
    "northStar": "Campus Glass",
    "overview": "The user chose a dark schedule interface with a glass effect. Graphite, translucent panels and muted lavender support a calm, practical student tool. The nearest lesson and its room supply the strongest visual emphasis; this is an operating screen with real schedule data.\n\nThe system remains usable in light and system themes and without transparency. Freshness, source uncertainty and incomplete data remain readable parts of the interface. This document records source implementation in `styles/campus.css`, `static/index.html`, `static/simple-ui.js` and `static/accessibility.js`; it does not claim independent visual or contrast verification.",
    "keyCharacteristics": [
      "Dark graphite canvas with restrained lavender emphasis.",
      "Large room typography and a compact readable day agenda.",
      "Translucent bordered surfaces with opaque fallbacks.",
      "Quiet state changes and immediate keyboard interaction."
    ],
    "rules": [
      {
        "name": "The Truth Stays Visible Rule",
        "body": "Never use low contrast or decoration to hide data age, saved/offline delivery, incomplete parsing or ambiguous teacher identity.",
        "section": "colors"
      },
      {
        "name": "The Readable Glass Rule",
        "body": "Glass must stay readable without blur. Reduced-transparency preferences use the opaque panel token and disable blur; unsupported backdrop filtering also uses the opaque panel. Never depend on a background image for contrast.",
        "section": "elevation"
      },
      {
        "name": "The Quiet Schedule Rule",
        "body": "Frequent day/week switches and clock ticks do not animate content entrances. Reduced motion disables button transitions, press scaling and dialog entrances. General button state transitions use 160ms for color and border and 120ms for press transforms. The drawer easing token exists in CSS but no documented component currently consumes it.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** keep source status and warnings readable alongside the schedule.",
      "**Do** use the existing system font and let long subject names wrap.",
      "**Do** preserve native details, selected-state semantics and dialog focus behavior.",
      "**Do** verify dark, light, opaque fallback and reduced-motion states when extending components."
    ],
    "donts": [
      "**Don't** animate frequent day changes or delay keyboard dialog access.",
      "**Don't** fabricate rooms, dates or a current lesson when source data cannot establish them.",
      "**Don't** introduce blur-dependent readability or promote legacy dialog shadows into the canonical surface style.",
      "**Don't** replace functional warnings with color-only signals."
    ]
  }
