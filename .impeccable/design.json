      "css": ".ds-search{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;color:var(--campus-ink,#f1f2f8);border:1px solid var(--campus-line,rgba(213,219,255,.15));background:var(--campus-control,rgba(205,214,255,.07));min-height:44px;border-radius:10px;padding:0 14px;font-size:14px;caret-color:var(--campus-accent,#cfbfff);}.ds-search:focus-visible{outline:2px solid var(--campus-focus,#d5c7ff);outline-offset:4px;}.ds-search::placeholder{color:var(--campus-muted,#b2b9cd);opacity:1}"
