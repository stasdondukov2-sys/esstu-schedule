      "css": ".ds-primary{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Arial,sans-serif;background:var(--campus-solid,#7252be);color:#fff;min-height:44px;border:0;border-radius:9px;padding:0 16px;cursor:pointer;transition:background-color 160ms ease,transform 120ms cubic-bezier(.23,1,.32,1);}.ds-primary:focus-visible{outline:2px solid var(--campus-focus,#d5c7ff);outline-offset:4px;}.ds-primary:hover{background:var(--campus-solid,#7252be)}.ds-primary:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}"
