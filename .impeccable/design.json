  "components": [
    {
      "name": "Filled action",
      "kind": "button",
      "refersTo": "button-primary",
      "html": "<button class=\"ds-primary\">Сохранить</button>",
      "css": ".ds-primary{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);transition:background-color 160ms ease,border-color 160ms ease,transform 120ms cubic-bezier(.23,1,.32,1);font-size:1rem;min-height:44px;padding:0 16px;border:0;border-radius:9px;background:var(--campus-solid,#087958);color:#fff;cursor:pointer}.ds-primary:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-primary:hover{background:var(--campus-solid,#087958)}.ds-primary:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active{transform:none}}",
      "description": "Filled sheet action; pointer press example."
    },
    {
      "name": "Glossy control",
      "kind": "button",
      "refersTo": "button-glass",
      "html": "<button class=\"ds-glass\">Выбрать расписание</button>",
      "css": ".ds-glass{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);background:linear-gradient(155deg,rgba(255,255,255,.13),transparent 46%),var(--campus-glass,rgba(13,16,22,.92));border:1px solid var(--campus-line,rgba(255,255,255,.1));box-shadow:inset 0 1px 1px var(--liquid-edge,rgba(255,255,255,.34)),inset 0 -1px 1px rgba(0,0,0,.08),0 8px 18px -12px var(--liquid-shadow,rgba(0,0,0,.7));transition:background-color 160ms ease,border-color 160ms ease,transform 120ms cubic-bezier(.23,1,.32,1);font-size:1rem;min-height:44px;padding:0 12px;border-radius:18px;cursor:pointer}.ds-glass:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-glass:hover{border-color:var(--campus-focus,#6ee7b7)}.ds-glass:active{transform:scale(.98)}@media(prefers-reduced-motion:reduce){.ds-glass{transition:none}.ds-glass:active{transform:none}}",
      "description": "Group selector material."
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search-field",
      "html": "<input class=\"ds-input\" aria-label=\"Поиск расписания\" placeholder=\"Поиск группы\"/>",
      "css": ".ds-input{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);font-size:1rem;min-height:48px;padding:10px 13px;border:1px solid var(--campus-line,rgba(255,255,255,.1));border-radius:16px;background:var(--campus-control,rgba(255,255,255,.045));caret-color:var(--campus-accent,#50dbb1)}.ds-input:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-input::placeholder{color:var(--campus-muted,#bcc5d2);opacity:1}.ds-input:focus-visible{outline-offset:0;border-color:transparent}",
      "description": "Full-size search field."
    },
    {
      "name": "Room droplet",
      "kind": "chip",
      "refersTo": "room-chip",
      "html": "<span class=\"ds-room\">ауд. —</span>",
      "css": ".ds-room{font:650 .75rem \"JetBrains Mono\",monospace;padding:2px 10px;border-radius:999px;display:inline-block;color:var(--liquid-room-ink,#e2e8f0);background:var(--liquid-room-bg,rgba(148,163,184,.18));border:1px solid rgba(var(--liquid-rgb,148,163,184),.45);box-shadow:inset 0 1px 1px var(--liquid-edge,rgba(255,255,255,.34)),0 4px 11px -6px rgba(var(--liquid-rgb,148,163,184),.75)}.ds-room:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}",
      "description": "Informational placeholder; no invented room."
    },
    {
      "name": "Lesson glass",
      "kind": "card",
      "refersTo": "lesson-card",
      "html": "<article class=\"ds-card\"><details><summary><strong>Выберите расписание</strong><span>Данные появятся после загрузки источника.</span></summary><p>Сведения, действия и заметки занятия.</p></details></article>",
      "css": ".ds-card{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);background:radial-gradient(ellipse at 15% 0%,var(--liquid-tint,rgba(148,163,184,.06)),transparent 72%),linear-gradient(145deg,var(--liquid-top,rgba(30,34,43,.66)),var(--liquid-bottom,rgba(8,10,16,.88)));border:1px solid rgba(var(--liquid-rgb,148,163,184),.42);box-shadow:inset 0 1.5px 1px var(--liquid-edge,rgba(255,255,255,.34)),inset 0 -1px 1px rgba(var(--liquid-rgb,148,163,184),.15),0 12px 26px -16px rgba(var(--liquid-rgb,148,163,184),.3),0 10px 24px -10px var(--liquid-shadow,rgba(0,0,0,.7));border-radius:22px;padding:15px;backdrop-filter:blur(28px) saturate(185%)}.ds-card:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-card summary{cursor:pointer;min-height:44px;list-style:none}.ds-card strong{display:block;font-size:.9375rem;font-weight:750;line-height:1.4;letter-spacing:-.018em}.ds-card span,.ds-card p{display:block;font-size:.75rem;line-height:1.5;color:var(--campus-muted,#bcc5d2)}.ds-card summary:hover strong{color:var(--campus-accent,#50dbb1)}.ds-card summary:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}@media(max-width:700px){.ds-card{padding:13px}}@media(prefers-reduced-transparency:reduce){.ds-card{background:var(--campus-panel,#101218);backdrop-filter:none}}@supports not(backdrop-filter:blur(1px)){.ds-card{background:var(--campus-panel,#101218)}}",
      "description": "Neutral disclosure with truthful placeholder."
    },
    {
      "name": "Floating navigation",
      "kind": "nav",
      "refersTo": "floating-nav",
      "html": "<nav class=\"ds-nav\" aria-label=\"Основная навигация\"><button><svg aria-hidden=\"true\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M4 4h16v16H4z M4 9h16 M9 9v11\"/></svg><span>Расписание</span></button><button><svg aria-hidden=\"true\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"m15 15 6 6 M17 10a7 7 0 1 1-14 0 7 7 0 0 1 14 0\"/></svg><span>Поиск</span></button><button><svg aria-hidden=\"true\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M6 21V3h12v18 M3 21h18 M14 12h1\"/></svg><span>Аудитории</span></button></nav>",
      "css": ".ds-nav{font-family:Inter,sans-serif;color:var(--campus-ink,#f8fafc);background:linear-gradient(155deg,rgba(255,255,255,.13),transparent 46%),var(--campus-glass,rgba(13,16,22,.92));border:1px solid var(--campus-line,rgba(255,255,255,.1));box-shadow:inset 0 1px 1px var(--liquid-edge,rgba(255,255,255,.34)),inset 0 -1px 1px rgba(0,0,0,.08),0 8px 18px -12px var(--liquid-shadow,rgba(0,0,0,.7));display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding:7px;border-radius:24px;width:360px;max-width:100%;backdrop-filter:blur(22px)}.ds-nav:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}.ds-nav button{transition:background-color 160ms ease,border-color 160ms ease,transform 120ms cubic-bezier(.23,1,.32,1);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:52px;padding:6px 8px;border:0;border-radius:17px;background:transparent;color:var(--campus-muted,#bcc5d2);font:500 .75rem Inter,sans-serif;cursor:pointer}.ds-nav button:first-child,.ds-nav button:hover{background:var(--campus-accent-soft,rgba(16,185,129,.12));color:var(--campus-accent,#50dbb1)}.ds-nav button:active{transform:scale(.98)}.ds-nav button:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}.ds-nav button:active{transform:none}}@media(prefers-reduced-transparency:reduce){.ds-nav{background:var(--campus-panel,#101218);backdrop-filter:none}}",
      "description": "Schedule remains highlighted while tool sheets open."
    }
  ],
  "narrative": {
    "northStar": "Dark Liquid Glass",
    "overview": "True black, a static neutral ambient wash and glossy bevels turn the timetable into compact glass objects. This world follows the user's pinned ai_studio_code.html and replaces Stealth Cyber-Glass. Its material serves a working schedule: source uncertainty, room identity and long subjects remain readable.\n\nThe shipped source is styles/liquid.css after styles/campus.css, with local fonts, utility adjustments in styles/input.css, and card/day markup in static/simple-ui.js. Dark and light themes share geometry with separate inks and glass. Final dark mobile, desktop and light mobile captures show the implementation; their visible test-clock state is not a claim about the live schedule.",
    "keyCharacteristics": [
      "Black glass with bright upper bevels and darker lower edges.",
      "Type-tinted cards, informational room droplets and compact mono numerals.",
      "Emerald current state, readable neutral past state and truthful source status.",
      "Glossy controls and sheets with keyboard, motion and transparency alternatives."
    ],
    "rules": [
      {
        "name": "The State Before Type Rule",
        "body": "Current emerald and past neutral override categorical tint. A mixed card never invents a dominant lesson type; preserve each actual label.",
        "section": "colors"
      },
      {
        "name": "The Readable Past Rule",
        "body": "Quiet past text remains readable, expandable and annotatable. Never fade the complete card.",
        "section": "typography"
      },
      {
        "name": "The Material Has Edges Rule",
        "body": "Keep the upper highlight, darker lower edge and translucent body together; flat tint alone does not reproduce this world.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve truthful source status, dates, lesson types and room identities.",
      "**Do** use local Inter text and JetBrains Mono for compact functional numerals.",
      "**Do** retain native disclosure, keyboard focus and readable light/opaque/reduced-motion states."
    ],
    "donts": [
      "**Don't** import demo timetable data or infer occupancy beyond known scheduled lessons.",
      "**Don't** fade past cards or present informational room droplets as standalone navigation.",
      "**Don't** flatten the bevel, add continuous ambient animation, or apply card corners to every overlay.",
      "**Don't** replace text labels or source warnings with colour alone."
    ]
  }
}
