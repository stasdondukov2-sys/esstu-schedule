      "css": ".ds-footer{display:flex;justify-content:space-between;align-items:center;padding:20px 2px 0;color:var(--campus-muted,#bcc5d2);font:11px Inter,sans-serif}.ds-footer>a{font-family:\"JetBrains Mono\",monospace;color:inherit}.ds-footer>div{display:flex;align-items:center;gap:7px}.ds-footer button{min-height:32px;border:0;background:transparent;color:inherit;font:11px Inter,sans-serif;cursor:pointer}.ds-footer button:hover,.ds-footer>a:hover{color:var(--campus-accent,#50dbb1)}.ds-footer button:focus-visible,.ds-footer>a:focus-visible{outline:2px solid var(--campus-focus,#6ee7b7);outline-offset:2px}"
