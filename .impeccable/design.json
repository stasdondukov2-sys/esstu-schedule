      "time": {
        "displayName": "Compact numerals",
        "purpose": "Local JetBrains Mono for times and calendar dates."
      }
    },
    "shadows": [
      {
        "name": "liquid-card",
        "value": "inset 0 1.5px 1px var(--liquid-edge),inset 0 -1px 1px rgba(var(--liquid-rgb),.15),0 12px 26px -16px rgba(var(--liquid-rgb),.3),0 10px 24px -10px var(--liquid-shadow)",
        "purpose": "Upper bevel, lower edge and diffuse depth."
      }
    ],
    "motion": [
      {
        "name": "button-state",
        "value": "160ms ease",
        "purpose": "Colour and border."
      },
      {
        "name": "button-press",
        "value": "120ms cubic-bezier(.23,1,.32,1)",
        "purpose": "Pointer-only .98 scale; reduced motion disables."
      },
      {
        "name": "sheet-entry",
        "value": "200ms cubic-bezier(.23,1,.32,1)",
        "purpose": "Existing pointer entry; keyboard immediate."
      },
      {
        "name": "loading-skeleton",
        "value": "1.5s ease-in-out infinite",
        "purpose": "Loading only; reduced motion disables."
      },
      {
        "name": "schedule-change",
        "value": "0ms",
        "purpose": "No day/week or clock entrances."
      },
      {
        "name": "sheet-drag-reset",
        "value": "160ms cubic-bezier(.23,1,.32,1)",
        "purpose": "Short/cancelled mobile drag reset; downward >80px closes; reduced motion immediate."
      }
